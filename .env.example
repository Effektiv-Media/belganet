# Copy this file to .env.local and fill in real values.

# Resend (https://resend.com) — used by app/api/contact/route.ts to email
# form submissions. Without these two set, the contact form still works
# end-to-end (accepts submissions, returns success) but no email is sent —
# a warning is logged server-side instead, so you can test the form before
# wiring up real credentials.
RESEND_API_KEY=
# Must be an address on a domain you've verified in Resend, e.g.
# "Belganet Städ och Allservice <no-reply@belganetstadochallservice.se>"
CONTACT_FROM_EMAIL=

# Optional — defaults to angelica88lundberg@gmail.com if unset.
CONTACT_TO_EMAIL=
